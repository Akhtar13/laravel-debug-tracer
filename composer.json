{
  "name": "akhtar/laravel-debug-tracer",
  "description": "On-demand, token-scoped, file-based debug tracing for Laravel. Zero setup, zero migrations, zero Redis.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "debug",
    "tracing",
    "logging",
    "queue"
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Akhtar\\LaravelDebugTracer\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "authors": [
    {
      "name": "Akhtar13",
      "email": "diwanakhtar34@gmail.com"
    }
  ],
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0",
    "laravel/pint": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Akhtar\\LaravelDebugTracer\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Akhtar\\LaravelDebugTracer\\DebugTracerServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
